# Keep byte-verified source and manifests identical on every Git checkout,
# including clients configured with core.autocrlf=true. Do not normalize only
# inside the verifier: the checked-out bytes themselves are the contract.
* text=auto eol=lf
.gitattributes text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.wat text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.csv text eol=lf
*.sh text eol=lf

# Preserve binary assets byte-for-byte; never attempt end-of-line conversion.
*.wasm binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.whl binary
*.npy binary
*.npz binary
*.woff binary
*.woff2 binary
