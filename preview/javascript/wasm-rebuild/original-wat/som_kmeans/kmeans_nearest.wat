(module
 (memory (export "memory") 1)
 (func (export "nearest") (param $xp i32) (param $cp i32) (param $n i32) (param $d i32) (param $k i32) (param $stride i32) (param $lp i32) (param $dp i32) (param $fp i32)
  (local $i i32) (local $c i32) (local $f i32) (local $best i32) (local $unsafe i32) (local $xo i32)
  (local $sum v128) (local $delta v128) (local $x v128) (local $a f64) (local $b f64) (local $distance f64)
  (block $rows_done (loop $rows_next
   (br_if $rows_done (i32.ge_u (local.get $i) (local.get $n)))
   (local.set $xo (i32.add (local.get $xp) (i32.mul (i32.mul (local.get $i) (local.get $d)) (i32.const 8))))
   (local.set $distance (f64.const inf)) (local.set $best (i32.const 0)) (local.set $unsafe (i32.const 0)) (local.set $c (i32.const 0))
   (block $centers_done (loop $centers_next
    (br_if $centers_done (i32.ge_u (local.get $c) (local.get $k)))
    (local.set $sum (v128.const f64x2 0 0)) (local.set $f (i32.const 0))
    (block $features_done (loop $features_next
     (br_if $features_done (i32.ge_u (local.get $f) (local.get $d)))
     (local.set $x (f64x2.splat (f64.load (i32.add (local.get $xo) (i32.mul (local.get $f) (i32.const 8))))))
     (local.set $delta (f64x2.sub (local.get $x) (v128.load (i32.add (local.get $cp) (i32.mul (i32.add (i32.mul (local.get $f) (local.get $stride)) (local.get $c)) (i32.const 8))))))
     (local.set $sum (f64x2.add (local.get $sum) (f64x2.mul (local.get $delta) (local.get $delta))))
     (local.set $f (i32.add (local.get $f) (i32.const 1))) (br $features_next)
    ))
    (local.set $a (f64x2.extract_lane 0 (local.get $sum)))
    (if (i32.or (f64.ne (local.get $a) (local.get $a)) (i32.or (f64.lt (local.get $a) (f64.const 2.2250738585072014e-308)) (f64.gt (local.get $a) (f64.const 1.7976931348623157e308)))) (then (local.set $unsafe (i32.const 1))))
    (if (f64.lt (local.get $a) (local.get $distance)) (then (local.set $distance (local.get $a)) (local.set $best (local.get $c))))
    (if (i32.lt_u (i32.add (local.get $c) (i32.const 1)) (local.get $k)) (then
     (local.set $b (f64x2.extract_lane 1 (local.get $sum)))
     (if (i32.or (f64.ne (local.get $b) (local.get $b)) (i32.or (f64.lt (local.get $b) (f64.const 2.2250738585072014e-308)) (f64.gt (local.get $b) (f64.const 1.7976931348623157e308)))) (then (local.set $unsafe (i32.const 1))))
     (if (f64.lt (local.get $b) (local.get $distance)) (then (local.set $distance (local.get $b)) (local.set $best (i32.add (local.get $c) (i32.const 1)))))
    ))
    (local.set $c (i32.add (local.get $c) (i32.const 2))) (br $centers_next)
   ))
   (i32.store (i32.add (local.get $lp) (i32.mul (local.get $i) (i32.const 4))) (local.get $best))
   (f64.store (i32.add (local.get $dp) (i32.mul (local.get $i) (i32.const 8))) (local.get $distance))
   (i32.store (i32.add (local.get $fp) (i32.mul (local.get $i) (i32.const 4))) (local.get $unsafe))
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $rows_next)
  ))
 )
)
