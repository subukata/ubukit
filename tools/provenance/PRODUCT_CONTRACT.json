{
  "schema_version": 1,
  "languages": {
    "python": {
      "root": "python",
      "runtime_root": "python/src",
      "runtime_glob": "**/*.py",
      "namespace": "ubukit",
      "source_manifest": "python/SOURCE_MANIFEST.json",
      "metadata": "python/pyproject.toml",
      "distribution": "ubukit-bundled-local-preview",
      "package_metadata": [
        "EXPERIMENTAL_LOCALIZED_SOM.md",
        "LICENSE-SOM.txt",
        "MANIFEST.in",
        "NOTICE-EXTERNAL-METRICS.txt",
        "NOTICE.txt",
        "NUMERICAL_LIMITS.md",
        "OPTIMIZATION.md",
        "README.md",
        "SOM.md",
        "SOURCE_MANIFEST.json",
        "THIRD_PARTY_LICENSES.txt",
        "pyproject.toml"
      ],
      "public_exports": [
        "ExecutionPolicy",
        "OptimizationResult",
        "PreparedData",
        "PreparedRMCM",
        "PreparedSOM",
        "ProposalError",
        "RMCMResult",
        "SOMState",
        "SearchSpaceExhausted",
        "TPEOptimizer",
        "Trial",
        "adjusted_mutual_info_score",
        "adjusted_rand_score",
        "adjusted_scores",
        "assign_rcm",
        "categorical",
        "fit_exrcm",
        "fit_fcm",
        "fit_fcm_numpy",
        "fit_kmeans",
        "fit_rcm",
        "fit_rmcm",
        "fit_rmcm_numpy",
        "fit_som",
        "fit_som_batch",
        "fit_som_olp",
        "float_range",
        "initialize_som",
        "initialize_som_batch",
        "initialize_som_olp",
        "int_range",
        "joint_quality",
        "optimize",
        "prepare",
        "prepare_rmcm",
        "run_som_olp",
        "som",
        "som_batch"
      ],
      "sdist_generated_files": [
        "PKG-INFO",
        "setup.cfg"
      ],
      "egg_info_files": [
        "PKG-INFO",
        "SOURCES.txt",
        "dependency_links.txt",
        "requires.txt",
        "top_level.txt"
      ],
      "wheel_metadata_files": [
        "METADATA",
        "WHEEL",
        "top_level.txt",
        "RECORD"
      ]
    },
    "javascript": {
      "root": "javascript",
      "runtime_root": "javascript/src",
      "runtime_glob": "**/*.js",
      "source_manifest": "javascript/SOURCE_MANIFEST.json",
      "metadata": "javascript/package.json",
      "entrypoints": [
        ".",
        "./worker",
        "./session",
        "./realtime-worker",
        "./metrics",
        "./optimization",
        "./external-metrics"
      ],
      "algorithms": [
        "kmeans",
        "fcm",
        "rcm",
        "exrcm",
        "rmcm",
        "som-olp",
        "som",
        "som_batch",
        "neighborhood"
      ]
    }
  },
  "verification": {
    "include": [
      ".github/**/*",
      "tools/**/*",
      "python/**/*",
      "javascript/**/*",
      "tests/**/*",
      "examples/**/*"
    ],
    "exclude_parts": [
      "__pycache__",
      ".pytest_cache",
      "node_modules",
      "artifacts",
      "dist",
      "build",
      "reports",
      "results",
      ".generated",
      ".npm-cache"
    ],
    "exclude_files": [
      "tools/provenance/VERIFICATION_SNAPSHOT.json"
    ]
  },
  "facade_parity": [
    "python/verification/python_api.py",
    "python/verification/runtime_tests/python_api.py"
  ]
}
