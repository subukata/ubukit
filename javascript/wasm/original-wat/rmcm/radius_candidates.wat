          (local.set $count (i32.add (local.get $count) (i32.const 1)))))
    (if (i32.and (local.get $mask) (i32.const 2)) (then (i32.store (i32.add (local.get $out) (i32.mul (local.get $count) (i32.const 4))) (i32.add (local.get $j) (i32.const 3)))
          (local.set $count (i32.add (local.get $count) (i32.const 1)))))))
   (local.set $mask (i64x2.bitmask (f64x2.le (f64x2.sqrt (local.get $s2)) (f64x2.splat (local.get $delta)))))
   (local.set $small (i64x2.bitmask (f64x2.lt (local.get $s2) (f64x2.splat (f64.const 2.2250738585072014e-308)))))
   (if (local.get $small) (then
    (if (i32.and (local.get $small) (i32.const 1)) (then (local.set $code (call $check_tiny (f64x2.extract_lane 0 (local.get $s2)) (local.get $base) (local.get $i) (i32.add (local.get $j) (i32.const 4)) (local.get $n) (local.get $d)))
          (if (local.get $code) (then (i32.store (local.get $error) (local.get $code)) (return (local.get $count))))))
    (if (i32.and (local.get $mask) (i32.const 1)) (then (i32.store (i32.add (local.get $out) (i32.mul (local.get $count) (i32.const 4))) (i32.add (local.get $j) (i32.const 4)))
          (local.set $count (i32.add (local.get $count) (i32.const 1)))))
    (if (i32.and (local.get $small) (i32.const 2)) (then (local.set $code (call $check_tiny (f64x2.extract_lane 1 (local.get $s2)) (local.get $base) (local.get $i) (i32.add (local.get $j) (i32.const 5)) (local.get $n) (local.get $d)))
          (if (local.get $code) (then (i32.store (local.get $error) (local.get $code)) (return (local.get $count))))))
    (if (i32.and (local.get $mask) (i32.const 2)) (then (i32.store (i32.add (local.get $out) (i32.mul (local.get $count) (i32.const 4))) (i32.add (local.get $j) (i32.const 5)))
