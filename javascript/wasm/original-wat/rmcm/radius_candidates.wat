   (local.set $mask (i64x2.bitmask (f64x2.le (f64x2.sqrt (local.get $s3)) (f64x2.splat (local.get $delta)))))
   (local.set $small (i64x2.bitmask (f64x2.lt (local.get $s3) (f64x2.splat (f64.const 2.2250738585072014e-308)))))
