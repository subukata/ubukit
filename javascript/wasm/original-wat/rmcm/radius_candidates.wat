          (local.set $count (i32.add (local.get $count) (i32.const 1)))))))
   (local.set $j (i32.add (local.get $j) (i32.const 8))) (br $loop_eight)))
  (block $end_two (loop $loop_two
   (br_if $end_two (i32.ge_u (i32.add (local.get $j) (i32.const 1)) (local.get $end)))
   (local.set $f (i32.const 0))
   (local.set $s0 (v128.const f64x2 0 0))
   (block $endf_two (loop $loopf_two
    (br_if $endf_two (i32.ge_u (local.get $f) (local.get $d)))
