   (local.set $mask (i64x2.bitmask (f64x2.le (f64x2.sqrt (local.get $s0)) (f64x2.splat (local.get $delta)))))
   (local.set $small (i64x2.bitmask (f64x2.lt (local.get $s0) (f64x2.splat (f64.const 2.2250738585072014e-308)))))
   (if (local.get $small) (then
    (if (i32.and (local.get $small) (i32.const 1)) (then (local.set $code (call $check_tiny (f64x2.extract_lane 0 (local.get $s0)) (local.get $base) (local.get $i) (i32.add (local.get $j) (i32.const 0)) (local.get $n) (local.get $d)))
