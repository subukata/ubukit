include README.md LICENSE LICENSE-SCOPE.txt LICENSE-SOM.txt NOTICE.txt NOTICE-EXTERNAL-METRICS.txt THIRD_PARTY_LICENSES.txt SOURCE_MANIFEST.json
recursive-include src *.py
recursive-exclude src __pycache__ *.pyc *.pyo *.nbc *.nbi
prune tests
prune benchmarks
prune evidence
prune validation

include OPTIMIZATION.md NUMERICAL_LIMITS.md

include SOM.md

include EXPERIMENTAL_LOCALIZED_SOM.md

prune tools
prune verification
prune artifacts
prune constraints
